{
  "name": "pfx-mcp-server",
  "displayName": "Proffix Px5 (pfx-mcp)",
  "version": "1.1.9",
  "description": "Connect Claude Code to Forterro Proffix Px5 through pfx-mcp. A pfx MCP API key is required, plus your Proffix REST credentials. The key is sent as Bearer to https://mcp.pfx.ch/api/server and is never optional.",
  "author": {
    "name": "Pedrett IT+Web AG",
    "url": "https://mcp.pfx.ch"
  },
  "homepage": "https://mcp.pfx.ch",
  "repository": "https://github.com/pitwch/pfx-mcp-server",
  "license": "MIT",
  "keywords": ["proffix", "erp", "mcp", "px5"],
  "userConfig": {
    "api_key": {
      "type": "string",
      "title": "API Key",
      "description": "Required. pfx MCP API key only, without the Bearer prefix. Request one at https://mcp.pfx.ch/request-api-key.html",
      "sensitive": true,
      "required": true
    },
    "proffix_username": {
      "type": "string",
      "title": "Proffix Username",
      "description": "Required. Proffix REST user.",
      "required": true
    },
    "proffix_password": {
      "type": "string",
      "title": "Proffix Password",
      "description": "Required. Proffix REST password or login token.",
      "sensitive": true,
      "required": true
    },
    "proffix_url": {
      "type": "string",
      "title": "Proffix Server URL",
      "description": "Required. Proffix host, e.g. https://your-proffix.example",
      "required": true
    },
    "proffix_port": {
      "type": "string",
      "title": "Proffix API Port",
      "description": "Proffix REST port.",
      "required": true,
      "default": "11011"
    },
    "proffix_database": {
      "type": "string",
      "title": "Proffix Database",
      "description": "Required. Proffix database name.",
      "required": true
    },
    "response_format": {
      "type": "string",
      "title": "Response Format",
      "description": "json (default) or toon.",
      "default": "json"
    }
  }
}
